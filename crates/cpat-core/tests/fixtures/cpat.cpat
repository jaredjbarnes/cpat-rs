# The cpat grammar, written in cpat: the self-host test builds it and
# checks it parses every fixture to the same tree as the hand-written
# grammar (src/grammar/cpat.rs, a port of v12's grammar.ts).
#
# Punctuation is written inline so that its nodes are named by their text,
# as the hand-written grammar names them ("|", "+", "(", ...). The one name
# a grammar file can't give is the comma's: v12 names a regex ",", and a
# rule name must be a word. It is `comma` here, and the test maps it.

ws = /\s+/
ls = /[ \t]+/
assign = "="
comma = /\s*[,]\s*/
newLine = /\s*(\r\n|\r|\n)\s*/
name = /[a-zA-Z_-]+[a-zA-Z0-9_-]*/
literal = /"(?:\\.|[^"\\])*"/
regex = /\/(?:\\.|[^\/\n\r])*\//
integer = /[1-9][0-9]*|[0]/
comment = /#[^\n\r]*/
patternName = name
patternIdentifier = name

syntax = "syntax"
syntaxVersion = /\S*/
syntaxStatement = syntax + ws? + syntaxVersion

# JSON, for decorator arguments.
jsonString = literal
jsonNumber = /-?\d+(\.\d+)?/
trueLiteral = "true"
falseLiteral = "false"
jsonBoolean = trueLiteral | falseLiteral
jsonNull = "null"
jsonArrayItems = (jsonValue, comma trim)+
jsonArray = "[" + ws? + jsonArrayItems + ws? + "]"
jsonObjectPropertyName = literal
jsonObjectProperty = jsonObjectPropertyName + ws? + ":" + ws? + jsonValue
jsonObjectProperties = (jsonObjectProperty, comma trim)+
jsonObject = "{" + ws? + jsonObjectProperties? + ws? + "}"
jsonValue = jsonString | jsonNumber | jsonBoolean | jsonNull | jsonArray | jsonObject

# Decorators.
decorationName = name
methodDecorationStatement = "@" + ws? + decorationName + ws? + "(" + ws? + jsonValue? + ws? + ")"
nameDecorationStatement = "@" + ws? + decorationName
decorationStatement = methodDecorationStatement | nameDecorationStatement

# Params.
useParams = "use params"
defaultParamName = name
paramDefault = ls? + assign + ls? + defaultParamName
paramNameWithDefault = patternName + paramDefault?
useParamPatterns = (paramNameWithDefault, comma trim)+
useParamsStatement = useParams + ls? + "{" + ws? + useParamPatterns + ws? + "}"

withParams = "with params"
withParamExportPattern = patternName
withParamStatement = patternAssignment | withParamExportPattern
withParamStatements = (withParamStatement, newLine trim)+
withParamsExpr = withParams + ls? + "{" + ws? + withParamStatements + ws? + "}"

# Imports.
import = "import"
from = "from"
as = "as"
resource = literal
importNameAlias = name
importAlias = patternName + ls + as + ls + importNameAlias
importNameOrAlias = importAlias | patternName
patternNames = (importNameOrAlias, comma trim)+
importedPatterns = "{" + ws? + patternNames + ws? + "}"
importStatement = import + ls? + importedPatterns + ls? + from + ls? + resource + ls? + withParamsExpr?

# Repeats.
oneOrMore = "+"
zeroOrMore = "*"
repeatBounds = "{" + ws? + integer? + ws? + comma? + ws? + integer? + ws? + "}"
repeatOptions = oneOrMore | zeroOrMore | repeatBounds
trim = "trim"
delimiter = comma + patternExpr + ws? + trim?
repeatExpr = "(" + ws? + patternExpr + ws? + delimiter? + ws? + ")" + repeatOptions

# Blocks.
blockDelimiter = "[" + ws? + literal + ws? + "]"
wildcard = "..."
blockContent = wildcard | patternExpr
blockExpr = blockDelimiter + ws? + blockContent + ws? + blockDelimiter

# Take until.
anyChar = "?"
upTo = "->"
wall = "|"
takeUntilExpr = anyChar + ls? + upTo + ls? + wall + ls? + patternExpr

# Operators. `patternExpr` is a Pratt choice: these refer back to it.
not = "!"
right = "right"
seqSeparator = "~/" | "+"
notExpr = not + ls? + patternExpr
optionalExpr = patternExpr + ls? + "?"
rightAssociationExpr = patternExpr + ls? + right
sequenceExpr = patternExpr + ws? + seqSeparator + ws? + patternExpr
optionsExpr = patternExpr + ws? + "|" + ws? + patternExpr
removedGreedyOptionsExpr = patternExpr + ws? + "<|>" + ws? + patternExpr
patternGroupExpr = "(" + ws? + patternExpr + ws? + ")"

patternExpr = notExpr | optionalExpr | rightAssociationExpr | sequenceExpr | optionsExpr | removedGreedyOptionsExpr | repeatExpr | patternGroupExpr | takeUntilExpr | blockExpr | literal | regex | patternIdentifier

# Statements.
patternAssignment = patternName + ws? + assign + ws? + patternExpr
exportPattern = patternName
statement = useParamsStatement | importStatement | patternAssignment | decorationStatement | exportPattern | comment
statements = (statement, newLine)+
cpat = ws? + syntaxStatement? + ws? + statements? + ws?
